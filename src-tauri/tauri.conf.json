{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Segna-Asta",
  "version": "0.1.0",
  "identifier": "com.dylanpatriarchi.segnaasta",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Segna-Asta",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Sports",
    "copyright": "Copyright © 2026 Dylan Patriarchi",
    "shortDescription": "Tool per l'asta del fantacalcio",
    "longDescription": "Listone, lista desideri e tracciamento live dell'asta del fantacalcio, con database SQLite locale. Nessun dato lascia il computer.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
